[Unit]
Description=maisondufrancais.fr : suppression des enregistrements oraux échus (tests de niveau)
After=postgresql.service

[Service]
Type=oneshot
User=maisondufrancais
WorkingDirectory=/var/www/maisondufrancais/app
ExecStart=/var/www/maisondufrancais/app/venv/bin/python -c "import web, placement; print('enregistrements supprimés :', placement.purge_recordings())"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/maisondufrancais/uploads
